{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.AspNetCore.Authentication": "Information",
                "Duende": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"],
        "Properties": {
            "Application": "AuthService"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Database=authdb;Username=authuser;Password=authpass123",
        "IdentityConnection": "Host=localhost;Database=authdb;Username=authuser;Password=authpass123"
    },
    "IdentityServer": {
        "IssuerUri": "https://login.platform.local:5086",
        "RequireHttpsMetadata": false
    },
    "Identity": {
        "Password": {
            "RequiredLength": 8,
            "RequireDigit": true,
            "RequireUppercase": true,
            "RequireLowercase": true,
            "RequireNonAlphanumeric": true
        },
        "User": {
            "RequireUniqueEmail": true
        },
        "SignIn": {
            "RequireConfirmedEmail": false,
            "RequireConfirmedPhoneNumber": false
        },
        "Lockout": {
            "DefaultLockoutTimeSpan": "00:05:00",
            "MaxFailedAccessAttempts": 5,
            "AllowedForNewUsers": true
        }
    },
    "Cors": {
        "AllowedOrigins": ["https://host-fe.platform.local:3002", "https://host-bff.platform.local:5086"]
    }
}
