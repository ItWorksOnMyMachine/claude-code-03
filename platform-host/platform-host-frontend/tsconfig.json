{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "jsx": "preserve",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    },
    "resolveJsonModule": true,
    "moduleResolution": "bundler"
  },
  "include": ["src", "shared", "config", "modern.config.ts"],
  "exclude": [
    "**/node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**/*",
    "src/setupTests.ts"
  ]
}
